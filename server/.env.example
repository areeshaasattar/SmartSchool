PORT=5000
MONGO_URI=mongodb://root:rootpassword@localhost:27017/smartschool?authSource=admin
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-jwt-secret-key
NODE_ENV=development
# Brevo SMTP (primary email provider)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_PASS=your-brevo-smtp-key

# Resend (fallback email provider)
RESEND_API_KEY=your-resend-api-key
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs > Senders)
EMAIL_FROM=you@example.com

# Frontend URL used in links sent by email (verification / password reset)
CLIENT_URL=http://localhost:5173

# Cloudinary (document storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=replace-with-the-same-long-random-shared-secret
